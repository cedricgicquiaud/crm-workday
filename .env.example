# Copier en `.env.local` pour le développement. Aucune valeur secrète n'est commitée.
# Les variables requises dépendent de l'environnement (voir src/lib/env.ts) :
#   - développement / test : DATABASE_URL, APP_URL, BETTER_AUTH_SECRET
#   - production          : les mêmes + RESEND_API_KEY

# Base Postgres (docker compose up -d). Les tests utilisent TEST_DATABASE_URL.
DATABASE_URL=postgres://crm:crm@localhost:5433/crm
TEST_DATABASE_URL=postgres://crm:crm@localhost:5433/crm_test

# Adresse publique de l'application
APP_URL=http://localhost:3000

# Secret de session (32 caractères au moins) : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Envoi d'emails. Requise en production seulement : en développement et en test,
# les emails sont capturés dans la boîte locale et jamais envoyés.
RESEND_API_KEY=

# Premier administrateur (npm run seed:admin), facultatif : les arguments priment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PASSWORD=
